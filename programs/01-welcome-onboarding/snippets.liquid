{{arrivals}}
{%- else -%}
{{content_blocks.${CB_WELCOME_BESTSELLERS_FALLBACK}}}
{%- endif %}
<p><a href="https://www.example.com/new?utm_source=braze&amp;utm_medium=email&amp;utm_campaign=EM_WELCOME_S5B">See everything new</a></p>
{{content_blocks.${CB_GLOBAL_FOOTER}}}
{% comment %} ================== END EM_WELCOME_S5B ================= {% endcomment %}
